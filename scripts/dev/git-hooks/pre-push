#!/usr/bin/env sh
# pre-push: the repository's pre-push hook, installed by scripts/dev/install-git-hooks.sh.
#
# 1. merged-pr-guard.sh: refuses a push to a branch whose PR is already merged or closed (see there).
# 2. Then the hook that was installed before this one, if the installer kept it as pre-push.chained.
# Both get git's arguments and the same stdin.
set -u

repo=$(git rev-parse --show-toplevel) || exit 1
hooks=$(git rev-parse --git-path hooks) || exit 1
input=$(cat)

printf '%s\n' "$input" | sh "$repo/scripts/dev/git-hooks/merged-pr-guard.sh" "$@" || exit 1

if [ -x "$hooks/pre-push.chained" ]; then
    printf '%s\n' "$input" | "$hooks/pre-push.chained" "$@" || exit 1
fi
exit 0
